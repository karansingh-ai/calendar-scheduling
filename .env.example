# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------

# Public URL people use to reach the app (used in links, emails and OAuth redirects).
APP_URL=https://schedule.example.com

# Encrypts calendar tokens and webhook secrets at rest. Generate: openssl rand -hex 32
# Keep it safe and stable: changing it disconnects every calendar.
ENCRYPTION_KEY=

# Used by docker-compose.yml for the bundled PostgreSQL.
POSTGRES_PASSWORD=

# When not using docker compose, point at your PostgreSQL directly:
# DATABASE_URL=postgres://user:password@host:5432/timebook

# ---------------------------------------------------------------------------
# Branding
# ---------------------------------------------------------------------------

# Product name shown in the UI and emails (white-label for your company).
APP_NAME=Timebook

# ---------------------------------------------------------------------------
# Email (strongly recommended). Without it, emails are printed to the log.
# ---------------------------------------------------------------------------

# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM="Acme Scheduling <scheduling@example.com>"

# ---------------------------------------------------------------------------
# Single sign-on (OpenID Connect): Okta, Entra ID, Google Workspace, Keycloak...
# Redirect URI to register with your identity provider: <APP_URL>/api/auth/oidc/callback
# ---------------------------------------------------------------------------

# Sign in with Google, reusing the Google calendar client below (add the redirect URI above to it):
# GOOGLE_SIGN_IN=true
# Or any other OpenID Connect provider:
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Microsoft
# OIDC_AUTO_PROVISION=true
# ALLOWED_EMAIL_DOMAINS=example.com
# Entra ID does not send email_verified; with a tenant-specific issuer you can trust its emails:
# OIDC_TRUST_UNVERIFIED_EMAIL=true
# Set to false to require SSO for everyone except the owner:
# PASSWORD_LOGIN=true

# ---------------------------------------------------------------------------
# Calendar integrations
# Google redirect URI:    <APP_URL>/api/integrations/google/callback
# Microsoft redirect URI: <APP_URL>/api/integrations/microsoft/callback
# ---------------------------------------------------------------------------

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------

# Behind a reverse proxy / load balancer that sets X-Forwarded-For:
# TRUST_PROXY=true   (or the number of proxies, e.g. 2 for a CDN plus a load balancer)
# Run the background worker (emails, reminders, webhooks) in this process:
# WORKER_ENABLED=true
# SESSION_DAYS=30
